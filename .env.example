# Copy to .env (run_windows.bat does this for you). NEVER commit .env.
LLM_PROVIDER=gemini
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Alternative: local model with Ollama (https://ollama.com), then set LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1
OLLAMA_URL=http://localhost:11434
BACKEND_URL=http://127.0.0.1:8000
